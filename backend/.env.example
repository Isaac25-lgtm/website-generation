# Copy to backend/.env (gitignored) and fill in. Real environment variables override this file.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is not 1:
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Neon). Copy the connection string from the Neon console. Never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Same meaning as the Worker settings in wrangler.jsonc / Worker secrets
PUBLIC_BASE_URL=http://localhost:8788
PAYMENTS_MODE=test
# ADMIN_EMAILS=
# APP_NAME=ImprintSites AI

# Optional: Workers AI over REST (leave unset to report AI as unavailable from Python)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
